# ==============================================================================
# Fuel Station Database Environment Configuration
# ==============================================================================

# Database Connection Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fuel_station_db
DB_USER=fuel_station
DB_PASSWORD=change_this_to_a_secure_password_in_production

# Standard Database Connection String
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# Application Configuration
APP_ENV=development
APP_PORT=3000

# Station Defaults
DEFAULT_CURRENCY=YER
DEFAULT_TIMEZONE=Asia/Aden

# Gemini API Configuration
GEMINI_API_KEY=AIzaSyPlaceholderKeyForBuild
